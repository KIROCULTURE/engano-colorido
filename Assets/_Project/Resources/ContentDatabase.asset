      - 'Prueba: versos 1 y 4 en -ado; versos 2 y 3 en -ida.'
      pasos:
      - id: cuarteto
        tipo: abba
        titulo: Tu verso
        enunciado: "Arma una estrofa de cuatro versos sobre c\xF3mo percibes la vida,
          con rima <b>abba</b>."
        plantilla: 
        voz: 
        usaInventario: 0
        estante: 0
        opciones:
        - texto: No quiero un rostro pintado
          tag: ado
        - texto: el reloj sigue a mi lado
          tag: ado
        - texto: y el ayer ya se ha marchado
          tag: ado
        - texto: prefiero vivir mi vida
          tag: ida
        - texto: con la luz que no se olvida
          tag: ida
        - texto: aunque el filtro me lo pida
          tag: ida
        - texto: "quiero quedarme en el sue\xF1o"
          tag: 
        - texto: todo lo cambia el tiempo
          tag: 
        slots:
        - etiqueta: Verso 1 (a)
          correcta: 
          opciones: []
          grupo: 0
        - etiqueta: Verso 2 (b)
          correcta: 
